<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Undertow</AssemblyName>
    <RootNamespace>RavenIron.Undertow</RootNamespace>
    <Version>1.0.3</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>Raven Iron</Company>
    <Product>Undertow</Product>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <!-- Keep the build machine's folders out of the shipped DLL. Without
         this the PE debug directory carries the absolute PDB path
         (C:\Users\<name>\...\obj\Release\Undertow.pdb), which exposes the
         Windows user name and makes the md5 depend on where the repo is
         checked out. The SDK maps each source root to /_/, /_1/, ... in the
         DLL, the PDB and the PDB's Source Link table alike. -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <!-- Always name the repo root as a source root for the mapping above.
         In a git checkout git adds the same root with its Source Link data
         and the two merge into one; without it (a source zip, a broken
         .git, git queries switched off) the folder would stay unmapped and
         its absolute path would go back into the DLL with no warning. -->
    <SourceRoot Include="$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))" />
  </ItemGroup>

  <!--
    Shared libs folder at the repository root, populated by tools\fetch-libs.ps1.
    Deliberately NOT a hardcoded Steam path: this repo gets cloned, and a Steam library
    move would break every checkout. libs\ is gitignored — each dev runs fetch-libs once.
  -->
  <PropertyGroup>
    <LibsDir>$(MSBuildThisFileDirectory)..\libs</LibsDir>
  </PropertyGroup>

  <Target Name="CheckLibs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(LibsDir)\assembly_valheim_publicized.dll')"
           Text="libs\ is missing or empty. Run tools\fetch-libs.ps1 to populate it from your Valheim install." />
  </Target>

  <ItemGroup>
    <!--
      Include names are the assemblies' real identities: the publicized files still
      identify as assembly_valheim / assembly_utils. Naming these '..._publicized'
      resolves via HintPath but warns on identity mismatch.
    -->
    <Reference Include="assembly_valheim">
      <HintPath>$(LibsDir)\assembly_valheim_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(LibsDir)\assembly_utils_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(LibsDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(LibsDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Rigidbody. This mod's entire write surface lives behind this reference. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(LibsDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      ParticleSystem. Client-only cosmetics: the visible current. Nothing behind this
      reference may ever touch gameplay (house rule 3), and it is dormant on a headless
      server, which has no graphics device to draw with.
    -->
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(LibsDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BepInEx">
      <HintPath>$(LibsDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(LibsDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="..\tests\**" />
  </ItemGroup>

</Project>
